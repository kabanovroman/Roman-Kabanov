{{ 'TEST.css' | asset_url | stylesheet_tag }}
<script src="{{ 'TEST.js' | asset_url }}" defer></script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

<test-vison-grid
    class="test-vision"
    id="test-vision-{{ section.id }}"
>   
    {%  if section.settings.heading != blank %}
        <h2 class="test-vison__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="test-vison__items">
        {% content_for 'blocks' %}
    </div>
</test-vison-grid>


{% schema %}
{
    "name": "TEST Vison",
    "class": "test-vision-section",
    "blocks": [
        {
            "type": "TEST-PRODUCT"
        }
    ],
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading"
        }
    ],
    "presets": [
        {
            "name": "TEST Vison"
        }
    ]
}
{% endschema %}