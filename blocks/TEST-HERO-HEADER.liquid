<div class="test-header">
    <div class="test-header__bar">
        <button class="test-header__toggle">
            <span class="test-header__burger">

            </span> 
        </button>

        <a class="test-header__logo" href="">
            {% if block.settings.logo !=blank %}
                {{ 
                    block.settings.logo | image_url: width: 320
                }}
            {% else %}
                <span class="test-header__logo-text">{{ block.settings.logo_text }}</span>
            {% endif %}
        </a>

        <span class="test-headedr__spacer"></span>

        {% if block.settings.announcement != blank %}
            <p class="test-header__announcement--desktop">
                {{ block.settings.announcement }}
            </p>
        {% endif %}

        {% if block.settings.choose_gift_label != blank %}
            <a class="test-header__choose-gift">
                <span>{{ block.settings.choose_gift_label }}</span>
                <span class="test-btn__arrow">
                    
                </span>
            </a>
        {% endif %}
    </div>  
</div>

{% schema %}
{
    "name": "Hero header",
    "settings": [
        {
            "type": "image_picker",
            "id": "logo",
            "label": "Logo Image"
        },
        {
            "type": "text",
            "id": "logo_text",
            "label": "Logo Text"
        },
        {
            "type": "text",
            "id": "announcement",
            "label": "Announcement text" 
        },
        {
            "type": "text",
            "id": "choose_gift_label",
            "label": "Choosee gift button label" 
        },
        {
            "type": "url",
            "id": "choose_gift_link",
            "label": "Choose gift button link"
        }
    ],
    "presets": [
        {
            "name": "Hero header"
        }
    ]
}
{% endschema %}