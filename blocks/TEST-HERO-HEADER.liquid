<div class="test-header">
  <div class="test-header__bar">
    <button class="test-header__toggle">
      <span class="test-header__burger">
        <span class="test-header__burger" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="12" viewBox="0 0 20 12" fill="none">
                <path d="M1 6H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M1 1H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M1 11H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </span>
        <span class="test-header__close" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none">
                <path d="M1 13.9994L13.7279 1.27147" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M1 1L13.7279 13.7279" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </span>
      </span>
    </button>

    <a class="test-header__logo" href="">
      {% if block.settings.logo != blank %}
        {{ block.settings.logo | image_url: width: 320 }}
      {% else %}
        <span class="test-header__logo-text">{{ block.settings.logo_text }}</span>
      {% endif %}
    </a>

    <span class="test-headedr__spacer"></span>

    {% if block.settings.announcement != blank %}
      <p class="test-header__announcement--desktop">
        {{ block.settings.announcement }}
      </p>
    {% endif %}

    {% if block.settings.choose_gift_label != blank %}
      <a class="test-header__choose-gift">
        <span>{{ block.settings.choose_gift_label }}</span>
        <span class="test-btn__arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="12" viewBox="0 0 26 12" fill="none">
            <path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
          </svg>
        </span>
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text"
    },
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement text"
    },
    {
      "type": "text",
      "id": "choose_gift_label",
      "label": "Choosee gift button label"
    },
    {
      "type": "url",
      "id": "choose_gift_link",
      "label": "Choose gift button link"
    }
  ],
  "presets": [
    {
      "name": "Hero header"
    }
  ]
}
{% endschema %}
