{% liquid
  assign desktop_image = block.settings.imaeg_desktop
  assign mobile_image = block.settings.image_mobile
  if mobile_image == blank
    assign  mobile_image = desktop_image
  endif
%}

<div class="test-hero__hero" {{ block.shopify_attributes }}>
    {% if desktop_image != blank %}
        <div class="test-hero__media test-hero__media--desktop">
            {{ 
                desktop_image | image_url: width: 2800 | image_tag: loading: 'eager', alt: block.settings.image_alt
            }}
        </div>
    {% endif %}

    {% if mobile_image != blank %}
        <div class="test-hero__media test-hero__media--mobile">
            {{ 
                mobile_image | image_url: width: 1500 | image_tag: loading: 'eager' , alt: block.settings.image_alt
            }}
        </div>
    {% endif %}

    <div class="test-hero__content">
        {% content_for 'blocks' %}
    </div>
</div>

{% schema %}
{
    "name": "Hero content",
    "blocks": [
        {
            "type": "TEST-HERO-HEADING"
        },
        {
            "type": "TEST-HERO-DESCRIPTION"
        },
        {
            "type": "TEST-HERO-BUTTON"
        }
    ],
    "settings": [
        {
            "type": "image_picker",
            "id": "imaeg_desktop",
            "label": "Desktop background image"
        },
        {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "Mobile background image",
        },
        {
            "type": "text",
            "id": "image_alt",
            "label": "image alt text"
        }
    ],
    "presets": [
        {
            "name": "Hero content"
        }
    ]
}
{% endschema %}